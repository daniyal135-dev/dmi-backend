# Copy to ".env" for local development (never commit .env).
# Matches docker-compose Postgres when DB runs via: docker compose up -d db redis

SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=dmi_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DATABASE_SSL_REQUIRE=false

REDIS_URL=redis://127.0.0.1:6379/0

# Optional: ngrok / Cloudflare Tunnel HTTPS URL for Vercel → local backend (comma-separated)
# Example: CORS_EXTRA_ORIGINS=https://abc123.ngrok-free.app
# CORS_EXTRA_ORIGINS=
# CSRF_TRUSTED_ORIGINS_EXTRA=https://abc123.ngrok-free.app

TEXT_INFERENCE_DEVICE=cpu
